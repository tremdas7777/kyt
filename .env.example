LEGACY_PUBLIC_KEY=
LEGACY_SECRET_KEY=
LEGACY_API_URL=https://api.legacyecombrasil.com
LEGACY_WEBHOOK_URL=
LEGACY_WEBHOOK_SECRET=
LEGACY_IS_PHYSICAL_PRODUCT=true

# PIX: escolha o gateway no painel. Chaves MagicPay já vão na loja (como a Legacy).
MAGICPAY_PIX_GATEWAY=
MAGICPAY_PUBLIC_KEY=
MAGICPAY_SECRET_KEY=
MAGICPAY_API_URL=https://api.dashboardmagicpay.com

# Gateway do PIX para todas as instâncias (legacy | magicpay | pixgate | sagacepay). Tem prioridade sobre o painel.
PIX_GATEWAY=
# Chaves PixGate / SagacePay. Quando preenchidas, têm prioridade sobre a chave salva no painel.
PIXGATE_API_KEY=
SAGACEPAY_API_KEY=

# Painel /admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Pixels (opcional — também dá para colar no painel)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=
TIKTOK_PIXEL_IDS=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=
GA_MEASUREMENT_ID=
GA_API_SECRET=
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=

# UTMify. Quando preenchido, tem prioridade sobre o token salvo no painel.
UTMIFY_API_TOKEN=
